# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Keys are optional at load time; a missing key only errors when a capability
# that needs it is actually invoked (see src/stock_agent/settings.py).

# ---- LLM ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096

# ---- Market / News providers ----
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
# yfinance requires no key.
# Additional free-tier news sources (all OPTIONAL — a provider is skipped until its key is set):
GUARDIAN_API_KEY=      # theme news, 5k/day — free dev key: https://open-platform.theguardian.com/access/
NEWSDATA_API_KEY=      # per-ticker + theme, ~200/day — https://newsdata.io/register
FMP_API_KEY=           # PAID for news: FMP's free 250/day tier covers quotes but NOT news endpoints
                       # (verified live → 402 Restricted). Omitted from PROVIDER_NEWS_PRIORITY below;
                       # add `fmp` back with a paid plan. https://site.financialmodelingprep.com/register
# Google News RSS and GDELT DOC are KEYLESS (no key needed).

# ---- RAG: SEC EDGAR (document download) ----
# SEC fair-access requires a descriptive User-Agent with a real contact (name + email).
# Required only for LIVE `documents download-sec` calls; tests use recorded fixtures.
SEC_USER_AGENT="Your Name your@email.com"
# Optional paid embedding backends (default is local fastembed; no key needed):
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
# EMBEDDING_PROVIDER=local   # local | openai | voyage

# ---- Provider behavior ----
PROVIDER_PRICE_PRIORITY=yfinance,alpha_vantage
# Per-ticker news (MERGE) and theme/topic news (FAILOVER). Keyed sources are skipped until their
# key is set; google_news_rss is keyless so both chains work with no extra keys. Omit either line
# to use the code default in settings.py.
PROVIDER_NEWS_PRIORITY=finnhub,marketaux,alpha_vantage,newsdata,google_news_rss
PROVIDER_TOPIC_PRIORITY=gdelt_doc,guardian,marketaux,newsdata,google_news_rss
CACHE_DIR=.cache
CACHE_TTL_SECONDS=86400
RATE_LIMIT_BUFFER=true

# ---- App ----
ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json
OUTPUT_DIR=outputs
RANDOM_SEED=42
