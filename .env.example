# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Keys are optional at load time; a missing key only errors when a capability
# that needs it is actually invoked (see src/stock_agent/settings.py).

# ---- LLM ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096

# ---- Market / News providers ----
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
# yfinance requires no key.

# ---- RAG: SEC EDGAR (document download) ----
# SEC fair-access requires a descriptive User-Agent with a real contact (name + email).
# Required only for LIVE `documents download-sec` calls; tests use recorded fixtures.
SEC_USER_AGENT="Your Name your@email.com"
# Optional paid embedding backends (default is local fastembed; no key needed):
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
# EMBEDDING_PROVIDER=local   # local | openai | voyage

# ---- Provider behavior ----
PROVIDER_PRICE_PRIORITY=yfinance,alpha_vantage
PROVIDER_NEWS_PRIORITY=finnhub,marketaux,alpha_vantage
CACHE_DIR=.cache
CACHE_TTL_SECONDS=86400
RATE_LIMIT_BUFFER=true

# ---- App ----
ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json
OUTPUT_DIR=outputs
RANDOM_SEED=42
